{
  "name": "healthy-backend",
  "version": "1.0.0",
  "description": "API REST para la app Healthy - salud y bienestar personalizada con IA",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "jest --config=jest.config.js --runInBand --forceExit",
    "test:unit": "jest --config=jest.config.js --testPathPatterns='tests/unit/' --runInBand",
    "test:integration": "jest --config=jest.config.js --testPathPatterns='tests/integration/' --runInBand --forceExit",
    "test:e2e": "jest --config=jest.config.js --testPathPatterns='tests/e2e/' --runInBand --forceExit",
    "test:watch": "jest --config=jest.config.js --watch",
    "test:coverage": "jest --config=jest.config.js --coverage --runInBand --forceExit",
    "test:load": "node ../tests/load/planGeneration.js",
    "retention": "node src/jobs/retention.js",
    "seed:foods": "node prisma/seed-foods.js",
    "import:bedca": "node prisma/import-bedca.js",
    "import:usda": "node prisma/import-usda.js",
    "import:openfoodfacts": "node prisma/import-openfoodfacts.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.52.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "nodemailer": "^6.9.15",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "xml2js": "^0.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "autocannon": "^7.15.0",
    "eslint": "9.39.4",
    "globals": "16.5.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
