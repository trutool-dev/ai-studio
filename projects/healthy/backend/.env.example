# Plantilla de variables de entorno del backend de Healthy.
# NUNCA pongas valores reales en este archivo. Copia a .env (no versionado) y rellena.
#
# SEC-46: al arrancar, server.js valida la configuración (src/config/env.js):
#   - NODE_ENV debe ser EXACTAMENTE development | test | staging | production (si no, no arranca)
#   - en staging/production una variable obligatoria ausente o débil aborta el arranque
#   - en development/test solo se muestran avisos
#
# Leyenda:  [OBLIGATORIA staging+prod]  [OBLIGATORIA prod]  [opcional]
# Lista consolidada tras la auditoría de seguridad 2026-10-19 (SEC-25..SEC-72).

# ── App / Servidor ──────────────────────────────────────────────────────────────
# [OBLIGATORIA] Valor exacto. Staging DEBE usar "staging" (no "production") y producción "production".
NODE_ENV=development
PORT=3000
# [opcional] SEC-32: número de proxies de confianza delante de la app (entero 0-10, NUNCA "true").
# Railway = 1 (valor por defecto si no se define). Determina req.ip para los rate limiters.
TRUST_PROXY=1

# ── Base de datos (PostgreSQL via Prisma) ─────────────────────────────────────
# [OBLIGATORIA staging+prod] Debe empezar por postgresql://
DATABASE_URL=postgresql://user:password@localhost:5432/healthy_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis (caché de planes IA, sesiones/revocación JWT, rate limiting, cuota IA) ─
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# [OBLIGATORIA staging+prod] Mínimo 32 caracteres (recomendado 64). Generar con: openssl rand -base64 64
# SEC-25: los valores anteriores están en el historial git → hay que ROTARLOS.
JWT_SECRET=
# [opcional] Duración del access token. Máximo 1h (p. ej. 15m, 900s, 1h). Por defecto 15m.
JWT_EXPIRES_IN=15m
# [OBLIGATORIA staging+prod] Mínimo 32 caracteres y distinto de JWT_SECRET.
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Seguridad de la caché Redis (SEC-10, SEC-16, SEC-46) ──────────────────────
# [OBLIGATORIA staging+prod] Clave AES-256-GCM: exactamente 64 caracteres hex. openssl rand -hex 32
REDIS_ENCRYPTION_KEY=
# [OBLIGATORIA staging+prod] Secreto HMAC-SHA256: mínimo 32 caracteres. openssl rand -hex 32
REDIS_HMAC_SECRET=

# ── Autenticación ─────────────────────────────────────────────────────────────
# [recomendada] SEC-31/SEC-45: secreto del HMAC de OTP y tokens de un solo uso (mín. 32 caracteres).
# Si no se define se usa JWT_SECRET (rotar JWT_SECRET invalidaría también los OTP pendientes).
OTP_HASH_SECRET=

# ── Endpoints de depuración / administración (SEC-30, SEC-39, SEC-71) ────────
# [opcional] Solo "true" activa /auth/dev/* y /health/ai, y además exige NODE_ENV en
# development | test | staging. En production el arranque FALLA si vale "true".
ENABLE_DEV_ENDPOINTS=false
# [opcional] Token de /auth/dev/* (cabecera X-Dev-Token). Mínimo 32 caracteres. Si no se define
# se usa ADMIN_TOKEN; si no hay ninguno, los endpoints dev responden 404 (fail-closed).
DEV_ENDPOINTS_TOKEN=
# [opcional] Dominios de email admitidos por /auth/dev/* (separados por comas).
# Por defecto: test.healthy.com — nunca dominios de usuarios reales.
DEV_ENDPOINTS_EMAIL_DOMAINS=test.healthy.com
# [opcional] Token de administración (cabecera X-Admin-Token). Mínimo 32 caracteres. openssl rand -hex 32
#   - /health/ai: obligatorio (sin él responde 404) + ENABLE_DEV_ENDPOINTS=true + NODE_ENV no production
#   - /health: con el token devuelve el detalle (versión, BD, Redis); sin él, solo status
ADMIN_TOKEN=

# ── RGPD ──────────────────────────────────────────────────────────────────────
# [opcional] SEC-47: versión vigente del consentimiento de datos de salud (Art. 9). Por defecto 1.0.
# Cambiarla obliga a los usuarios a volver a consentir antes de generar planes con IA.
HEALTH_CONSENT_VERSION=1.0

# [opcional] SEC-50: job de retención (src/jobs/retention.js). Purga sesiones, OTP y tokens
# de reset caducados y anonimiza IPs antiguas. Programador en proceso (src/jobs/scheduler.js):
# DESACTIVADO por defecto; con `true` se ejecuta a diario a RETENTION_SCHEDULER_HOUR_UTC (0-23).
# Alternativa: cron externo con `npm run retention`.
RETENTION_SCHEDULER_ENABLED=false
RETENTION_SCHEDULER_HOUR_UTC=3
# Plazos de retención: días tras caducar/revocar.
RETENTION_SESSION_DAYS=30
RETENTION_OTP_DAYS=30
RETENTION_RESET_DAYS=30
# Días que se conservan las IPs de sesión antes de anonimizarlas.
RETENTION_IP_DAYS=90

# ── Claude / Anthropic API ────────────────────────────────────────────────────
# [recomendada] Sin clave se usa el plan de respaldo por reglas.
ANTHROPIC_API_KEY=
# [opcional] SEC-70: modelo. Solo se aceptan los de la lista blanca de aiService.js
# (claude-sonnet-4-6, claude-haiku-4-5-20251001); cualquier otro valor se ignora.
ANTHROPIC_MODEL=claude-sonnet-4-6
# [opcional] SEC-55: timeout de la llamada en ms (acotado 10000-120000; por defecto 75000).
ANTHROPIC_TIMEOUT_MS=75000
# [opcional] SEC-55: reintentos del SDK (acotado 0-2; por defecto 1).
ANTHROPIC_MAX_RETRIES=1
# [opcional] SEC-56: cuota diaria de tokens de IA por usuario (0 = sin cuota; por defecto 60000).
# Al superarla se sirve el plan de respaldo sin llamar a la IA.
AI_DAILY_TOKEN_LIMIT=60000

# ── Sistema de prompts IA (SEC-09, SEC-70) ────────────────────────────────────
# [opcional] Sustituye solo la parte de producto del system prompt; el bloque de reglas de
# seguridad se concatena siempre y no se puede sobrescribir.
AI_SYSTEM_PROMPT=

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# [OBLIGATORIA prod] SMTP_HOST, SMTP_USER y SMTP_PASS (sin ellos production no arranca).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Healthy App <noreply@example.com>

# ── Frontend / App ────────────────────────────────────────────────────────────
# [recomendada] Orígenes permitidos por CORS, separados por comas
FRONTEND_URL=http://localhost:8081
API_URL=http://localhost:3000

# ── Progreso: fotos (SEC-64) ──────────────────────────────────────────────────
# [opcional] Hosts permitidos para photo_url (separados por comas; solo https). Se acepta el host
# exacto y sus subdominios. Si está vacío, photo_url se rechaza (por defecto conservador:
# no hay almacenamiento propio de fotos).
PHOTO_URL_ALLOWED_HOSTS=

# ── Supabase (OBSOLETO: Supabase se eliminó; no se usa en el código) ─────────
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
