# Plantilla de variables de entorno del backend de Healthy.
# NUNCA pongas valores reales en este archivo. Copia a .env (no versionado) y rellena.
# SEC-46: al arrancar, server.js valida la configuración (src/config/env.js):
#   - NODE_ENV debe ser development | test | staging | production (si no, no arranca)
#   - en staging/production una variable obligatoria ausente o débil aborta el arranque
#   - en development/test solo se muestran avisos

# ── App / Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# SEC-32: número de proxies de confianza delante de la app (entero 0-10, NUNCA "true").
# Railway = 1 (por defecto si no se define). Determina req.ip para los rate limiters.
TRUST_PROXY=1

# ── Base de datos (PostgreSQL via Prisma) — OBLIGATORIA en staging/production ──
DATABASE_URL=postgresql://user:password@localhost:5432/healthy_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis (caché de planes IA, sesiones JWT, búsqueda de alimentos) ───────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TLS=false

# ── JWT — OBLIGATORIAS en staging/production ─────────────────────────────────
# Mínimo 32 caracteres (recomendado 64). Generar con: openssl rand -base64 64
JWT_SECRET=
# Duración del access token. Máximo 1h (p. ej. 15m, 900s, 1h). Por defecto 15m.
JWT_EXPIRES_IN=15m
# Mínimo 32 caracteres y distinto de JWT_SECRET. Generar con: openssl rand -base64 64
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ── Seguridad de la caché Redis (SEC-10, SEC-16, SEC-46) — OBLIGATORIAS en staging/production ──
# Clave AES-256-GCM: exactamente 64 caracteres hex. Generar con: openssl rand -hex 32
REDIS_ENCRYPTION_KEY=
# Secreto HMAC-SHA256: mínimo 32 caracteres. Generar con: openssl rand -hex 32
REDIS_HMAC_SECRET=

# ── Autenticación (sub-equipo auth) ───────────────────────────────────────────
# Secreto del HMAC de los códigos OTP (si no se define se usa JWT_SECRET). Mínimo 32 caracteres.
OTP_HASH_SECRET=

# ── Endpoints de depuración / administración ─────────────────────────────────
# Habilita los endpoints de desarrollo (/auth/dev/*, /health/ai). Solo "true" los activa.
# Prohibido en production (el arranque falla). Por defecto deshabilitados.
ENABLE_DEV_ENDPOINTS=false
# Token para los endpoints dev de /auth (cabecera indicada por el sub-equipo auth). Mínimo 32 caracteres.
DEV_ENDPOINTS_TOKEN=
# Token de administración (cabecera X-Admin-Token). Mínimo 32 caracteres. Generar con: openssl rand -hex 32
#   - /health/ai: obligatorio (sin él, el endpoint responde 404); además requiere ENABLE_DEV_ENDPOINTS=true
#     y NODE_ENV en development | test | staging
#   - /health: con el token se devuelve el detalle (versión, BD, Redis); sin él, solo status
ADMIN_TOKEN=

# ── RGPD ──────────────────────────────────────────────────────────────────────
# Versión vigente de la política de consentimiento de datos de salud (Art. 9).
# Cambiarla obliga a re-consentir (lo gestiona el sub-equipo onboarding/IA).
HEALTH_CONSENT_VERSION=1.0

# ── Claude / Anthropic API ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Cuota de tokens de IA por usuario (nombre y unidad definitivos los fija el sub-equipo
# onboarding/IA; el orquestador actualizará esta sección).
# AI_TOKEN_QUOTA_PER_USER=

# ── Sistema de prompts IA (SEC-09) ────────────────────────────────────────────
AI_SYSTEM_PROMPT=      # opcional: sobreescribir system prompt en Railway

# ── Email (SMTP) — OBLIGATORIAS en production ─────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Healthy App <noreply@example.com>

# ── Frontend / App ────────────────────────────────────────────────────────────
# Orígenes permitidos por CORS, separados por comas
FRONTEND_URL=http://localhost:8081
API_URL=http://localhost:3000

# ── Progreso: fotos (SEC-64) ──────────────────────────────────────────────────
# Hosts permitidos para photo_url (separados por comas; solo https). Se acepta el host
# exacto y sus subdominios. Si está vacío, photo_url se rechaza (por defecto conservador:
# no hay almacenamiento propio de fotos).
PHOTO_URL_ALLOWED_HOSTS=

# ── Supabase (OBSOLETO: Supabase se eliminó; no se usa en el código) ─────────
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
