# ── App / Servidor ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos (PostgreSQL via Prisma) ────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/healthy_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ── Redis (caché de planes IA, sesiones JWT, búsqueda de alimentos) ───────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=healthy_redis_pass
REDIS_TLS=false

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 64
JWT_SECRET=your-secret-min-64-chars-here-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-min-64-chars-different-from-jwt-secret
JWT_REFRESH_EXPIRES_IN=30d

# ── Claude / Anthropic API ────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@healthy.app
SMTP_PASS=app-password
EMAIL_FROM=Healthy App <noreply@healthy.app>

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
