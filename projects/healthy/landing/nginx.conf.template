server {
    # Railway inyecta PORT; por defecto 8080 (ver Dockerfile)
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    # La landing publicada es index4.html → se sirve en /
    index index4.html;

    gzip on;
    gzip_types text/html text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Cabeceras de seguridad (se repiten en cada location porque add_header no se hereda)
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # index4.html carga los frames del canvas con ruta relativa 'public/frames/...'
    location ^~ /public/ {
        alias /usr/share/nginx/html/;
        expires 1d;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Imágenes y vídeos con caché de 24 h (los nombres no llevan hash)
    location ~* \.(png|jpg|jpeg|gif|ico|svg|webp|avif|mp4|webm|woff2?)$ {
        expires 1d;
        add_header Cache-Control "public, max-age=86400" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # HTML sin caché para que siempre se sirva la última versión
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Strict-Transport-Security "max-age=31536000" always;
        try_files $uri $uri/ /index4.html;
    }
}
