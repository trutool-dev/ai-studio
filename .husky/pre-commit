#!/bin/sh
# Pre-commit hook: detectar API keys y secretos antes de commitear (SEC-24)

# Colores
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

FOUND_SECRETS=0

for FILE in $STAGED_FILES; do
  # No revisar archivos de test, ejemplos ni documentación de política
  case "$FILE" in
    *test*|*.test.*|*.spec.*|*example*|*SECRETS_POLICY*|*.md)
      continue
      ;;
  esac

  # Detectar API keys de Anthropic
  if git diff --cached "$FILE" | grep -qE 'sk-ant-[a-zA-Z0-9_-]{20,}'; then
    printf "${RED}SECRETO DETECTADO: posible Anthropic API key en $FILE${NC}\n"
    FOUND_SECRETS=1
  fi

  # Detectar .env con valores reales (no plantillas)
  if echo "$FILE" | grep -qE '\.env$'; then
    if git diff --cached "$FILE" | grep -qvE '^\+.*=($|<|#|\$\{)'; then
      printf "${YELLOW}ADVERTENCIA: $FILE podría contener valores reales en lugar de plantillas${NC}\n"
    fi
  fi
done

if [ "$FOUND_SECRETS" -eq 1 ]; then
  printf "${RED}Commit bloqueado: se detectaron posibles secretos. Revisa los archivos indicados.${NC}\n"
  printf "Si es un falso positivo, usa: git commit --no-verify (solo si estás seguro)\n"
  exit 1
fi

exit 0
