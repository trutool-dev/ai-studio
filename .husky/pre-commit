#!/bin/sh
# Pre-commit hook: detección de secretos antes de commitear
# SEC-24 (versión inicial) — ampliado en SEC-42 (SA-11 + JB-20):
#   - revisa TODOS los archivos staged, incluidos *.md, tests y ejemplos
#   - solo analiza las líneas añadidas (+) del diff staged
#   - nunca imprime el valor detectado, solo el archivo y el tipo de secreto
# Los placeholders <...>, ${...}, $VAR, *** y xxx no se consideran secretos.
# Falso positivo verificado: añadir el comentario `gitleaks:allow` en esa línea
# (mismo marcador que respeta el job gitleaks de CI). No usar --no-verify.

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# Contraseña/valor que es claramente un placeholder (se usa anclado)
PLACEHOLDER='(<[^>]*>|\$\{[^}]*\}|\$[A-Za-z_][A-Za-z0-9_]*|%[A-Za-z_][A-Za-z0-9_]*%|\*+|[xX]{3,}|\.\.\.|password|pass|pwd|secret|changeme)'
# Hosts de desarrollo local (contenedores de CI / docker-compose)
LOCAL_HOST='(localhost|127\.0\.0\.1|\[::1\]|host|<[^>]*>|\$\{[^}]*\})'
# Palabras que delatan un valor de ejemplo en JWT_SECRET=...
EXAMPLE_WORDS='(test|example|your-|change|placeholder|dummy|fake|sample|ci-only|not-used|development|process\.env|generar|generate)'

FOUND_SECRETS=0

report() {
  printf "${RED}SECRETO DETECTADO (%s) en %s${NC}\n" "$2" "$1"
  FOUND_SECRETS=1
}

OLD_IFS=$IFS
IFS='
'
for FILE in $STAGED_FILES; do
  IFS=$OLD_IFS

  # Líneas añadidas, sin cabeceras del diff y sin las marcadas como permitidas
  ADDED=$(git diff --cached -U0 --no-color -- "$FILE" \
    | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -v 'gitleaks:allow')
  if [ -z "$ADDED" ]; then
    IFS='
'
    continue
  fi

  # 1. API keys de Anthropic
  if printf '%s\n' "$ADDED" | grep -qE 'sk-ant-[A-Za-z0-9_-]{20,}'; then
    report "$FILE" "Anthropic API key"
  fi

  # 2. URLs de BD/Redis con contraseña (usuario:contraseña@host)
  if printf '%s\n' "$ADDED" \
    | grep -oE '(postgres(ql)?|rediss?|mysql|mongodb(\+srv)?)://[^:/@[:space:]]+:[^@[:space:]]+@[^/:[:space:]`"'"'"']+' \
    | grep -vE "://[^:]+:${PLACEHOLDER}@" \
    | grep -qvE "@${LOCAL_HOST}\$"; then
    report "$FILE" "URL de base de datos con contraseña"
  fi

  # 3. JWT_SECRET= / JWT_REFRESH_SECRET= con un valor que no es placeholder
  if printf '%s\n' "$ADDED" \
    | grep -oE 'JWT_(REFRESH_)?SECRET[[:space:]]*[=:][[:space:]]*["'"'"'`]?[^"'"'"'`[:space:]|]+' \
    | sed -E 's/^JWT_(REFRESH_)?SECRET[[:space:]]*[=:][[:space:]]*["'"'"'`]?//' \
    | grep -vE "^${PLACEHOLDER}\$" \
    | grep -viE "${EXAMPLE_WORDS}" \
    | grep -qE '.{16,}'; then
    report "$FILE" "JWT_SECRET con valor"
  fi

  # 4. Valor largo de alta entropía en una línea que habla de un secreto
  #    (caso SA-01: tabla Markdown con el valor del JWT_SECRET)
  if printf '%s\n' "$ADDED" \
    | grep -iE '(secret|token|password|passwd|api[_-]?key|private[_-]?key)' \
    | grep -qE '[A-Za-z0-9+/]{40,}={0,2}'; then
    report "$FILE" "valor de alta entropía junto a SECRET/TOKEN/PASSWORD/KEY"
  fi

  # 5. Claves privadas PEM (cabecera en línea propia o embebida en JSON)
  if printf '%s\n' "$ADDED" \
    | grep -qE '^\+[[:space:]]*["'"'"']?-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----|-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----(\\n|[[:space:]]+)[A-Za-z0-9+/]{20,}'; then
    report "$FILE" "clave privada PEM"
  fi

  # 6. Tokens de GitHub
  if printf '%s\n' "$ADDED" | grep -qE '(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,}'; then
    report "$FILE" "token de GitHub"
  fi

  # Aviso (no bloquea): .env con valores reales en lugar de plantillas
  if echo "$FILE" | grep -qE '(^|/)\.env$'; then
    if printf '%s\n' "$ADDED" | grep -qvE '^\+[^=]*=($|<|#|\$\{)'; then
      printf "${YELLOW}ADVERTENCIA: %s podría contener valores reales en lugar de plantillas${NC}\n" "$FILE"
    fi
  fi

  IFS='
'
done
IFS=$OLD_IFS

if [ "$FOUND_SECRETS" -eq 1 ]; then
  printf "${RED}Commit bloqueado: se detectaron posibles secretos. Sustitúyelos por un placeholder o una variable de entorno.${NC}\n"
  printf "Si es un falso positivo verificado, marca la línea con el comentario gitleaks:allow (ver backend/SECRETS_POLICY.md).\n"
  exit 1
fi

exit 0
